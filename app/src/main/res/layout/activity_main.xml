<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F7F5EF">
    <LinearLayout
        android:orientation="vertical" android:padding="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layoutDirection="rtl">
        <TextView android:id="@+id/title" android:text="أذكاري"
            android:textSize="30sp" android:textStyle="bold" android:textColor="#173F36"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="رفيقك اليومي للذكر 🌙"
            android:textSize="16sp" android:textColor="#55736A"
            android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/progress" android:text="تقدم اليوم: 0%"
            android:textSize="17sp" android:textStyle="bold" android:textColor="#2E7D6B"
            android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <Button android:id="@+id/morning" android:text="☀️ أذكار الصباح"
            android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/evening" android:text="🌅 أذكار المساء"
            android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/prayer" android:text="🕌 أذكار بعد الصلاة"
            android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/sleep" android:text="🌙 أذكار النوم"
            android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/tasbeeh" android:text="📿 السبحة الإلكترونية"
            android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:id="@+id/dhikrText"
            android:text="اختر قسمًا للبدء"
            android:textSize="22sp" android:textColor="#183B34"
            android:gravity="center" android:padding="24dp"
            android:layout_marginTop="22dp" android:background="#FFFFFF"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <Button android:id="@+id/countButton" android:text="اضغط للتسبيح"
            android:visibility="gone" android:layout_marginTop="12dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/resetButton" android:text="إعادة العداد"
            android:visibility="gone" android:layout_marginTop="6dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
